{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "dsh-exit · 退出流程",
    "output": "docs/exit-flow-zh.html",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "client", "label": "客户端" },
    { "id": "gateway", "label": "Remote 网关" },
    { "id": "host", "label": "dsh 宿主" },
    { "id": "timer", "label": "应答等待" },
    { "id": "runtime", "label": "进程生命周期" },
    { "id": "outcome", "label": "端口结果" },
    { "id": "continuation", "label": "界面状态" }
  ],
  "phases": [
    { "id": "trigger", "label": "触发与确认", "fromCol": 0, "toCol": 1 },
    { "id": "invoke", "label": "调用宿主服务", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "shutdown", "label": "退出与释放", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "remote_boundary", "label": "Typert Remote 边界", "lane": "gateway", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "grace_window", "label": "应答窗口", "lane": "timer", "fromCol": 4, "toCol": 4, "variant": "dashed" }
  ],
  "mainPath": ["click", "confirm", "remote", "service", "grace", "exit", "ports"],
  "nodes": [
    { "id": "click", "lane": "client", "col": 0, "type": "frontend", "label": "退出按钮", "sublabel": "右下角浮动" },
    { "id": "confirm", "lane": "client", "col": 1, "type": "frontend", "label": "确认", "sublabel": "弹窗 / Esc" },
    { "id": "cancel", "lane": "outcome", "col": 0, "type": "frontend", "label": "继续使用", "sublabel": "取消分支" },
    { "id": "remote", "lane": "gateway", "col": 2, "type": "cloud", "label": "Remote 调用", "sublabel": "dshExit.exit()" },
    { "id": "service", "lane": "host", "col": 3, "type": "backend", "label": "宿主服务", "sublabel": "DshExitService" },
    { "id": "ack", "lane": "gateway", "col": 4, "type": "messagebus", "label": "返回 true", "sublabel": "先完成应答" },
    { "id": "grace", "lane": "timer", "col": 4, "type": "backend", "label": "等待 400 ms", "sublabel": "应答窗口" },
    { "id": "exit", "lane": "runtime", "col": 5, "type": "security", "label": "结束进程", "sublabel": "process.exit(0)", "tag": "终止" },
    { "id": "ports", "lane": "outcome", "col": 5, "type": "cloud", "label": "释放端口", "sublabel": "全部 socket" },
    { "id": "keep", "lane": "continuation", "col": 4, "type": "external", "label": "保留界面", "sublabel": "终端 + 标签页" }
  ],
  "edges": [
    { "from": "click", "to": "confirm", "role": "main" },
    { "from": "confirm", "to": "cancel", "label": "取消 / Esc", "role": "branch" },
    { "from": "confirm", "to": "remote", "label": "确认", "labelDx": 28, "role": "main", "variant": "emphasis" },
    { "from": "remote", "to": "service", "label": "/api/dshExit/exit", "role": "main", "variant": "emphasis" },
    { "from": "service", "to": "ack", "label": "return true", "role": "return" },
    { "from": "service", "to": "grace", "label": "setTimeout", "role": "main" },
    { "from": "grace", "to": "exit", "label": "400 ms 后", "role": "main", "variant": "security" },
    { "from": "exit", "to": "ports", "label": "释放 socket", "labelDy": 18, "role": "main", "variant": "emphasis" },
    { "from": "exit", "to": "keep", "label": "不主动关闭", "role": "branch", "variant": "dashed" }
  ],
  "cards": [
    { "dot": "violet", "title": "确认优先", "items": ["首次点击只打开确认弹窗", "取消、Esc 和点击外部都不会结束宿主", "确认按钮在请求期间禁用，避免重复调用"] },
    { "dot": "amber", "title": "先应答再退出", "items": ["Remote 方法返回 true", "宿主等待 400 ms 后执行 process.exit(0)", "重复调用由 exiting 标志保护"] },
    { "dot": "emerald", "title": "退出边界", "items": ["宿主进程退出后释放其占用的端口", "插件不操作终端窗口", "插件不主动关闭浏览器标签页"] }
  ]
}
